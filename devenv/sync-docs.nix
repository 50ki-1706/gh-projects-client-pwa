{ pkgs, lib, config }:
let
  escapeTableCell = value:
    lib.replaceStrings [ "|" "\r\n" "\n" "\r" ] [ "\\|" " " " " " " ] value;
  scriptRows = lib.concatStringsSep "\n" (lib.mapAttrsToList (name: script:
    "| ${escapeTableCell name} | ${escapeTableCell (script.description or "")} |"
  ) config.scripts);
  markdown = ''
    # devenv scripts
    <!-- DO NOT EDIT THIS FILE -->
    <!-- This file is automatically generated from devenv.nix -->

    | コマンド名 | 説明 |
    | --- | --- |
    ${scriptRows}
  '';
  generatedMarkdown = pkgs.writeText "scripts.md" markdown;
  root = lib.escapeShellArg config.devenv.root;
in
''
  root=${root}
  destination="$root/docs/scripts.md"

  if [ -L "$root/docs" ]; then
    printf '%s\n' "sync-docs: refusing symlinked docs directory: $root/docs" >&2
    exit 1
  fi

  mkdir -p "$root/docs"

  if [ -L "$destination" ] || [ -d "$destination" ]; then
    printf '%s\n' "sync-docs: refusing symlink or directory destination: $destination" >&2
    exit 1
  fi

  install -m 644 ${generatedMarkdown} "$destination"
''
