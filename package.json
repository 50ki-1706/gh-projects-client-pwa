    "fmt:check": "prettier --check \"{src,routes,tests}/**/*.{ts,tsx,mjs,cjs,css,md}\" \"*.{ts,json,html,md,yaml,yml}\" \"db/schema.ts\" \".github/**/*.{json,yaml,yml}\" \"docs/**/*.md\"",
    "test": "node --test tests/*.test.mjs",
    "dev": "vite",
    "build": "vite build",
    "typecheck": "void prepare && tsrs --noEmit",
    "typecheck:tsc": "void prepare && tsc --noEmit"
