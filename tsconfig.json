{
  "extends": "./.void/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["void/env", "vite/client"]
  },
  "include": [
    "auth.ts",
    "src",
    "routes",
    "tests/**/*.types.ts",
    "tests/browser/lifecycle-fixture.tsx",
    "middleware",
    "crons",
    "queues",
    "db"
  ]
}
