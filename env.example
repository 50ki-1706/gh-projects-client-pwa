# GitHub OAuth App を作成してください。
# Homepage URL: http://localhost:5173
# Authorization callback URL: http://localhost:5173/api/auth/callback/github
# 本番のコールバックURLは、デプロイ先のオリジン + /api/auth/callback/github です。
# ローカルではこのファイルを .env にコピーして使用してください。
# 本番の値は後で `void secret put` で設定し、絶対にコミットしないでください。
AUTH_GITHUB_CLIENT_ID=
AUTH_GITHUB_CLIENT_SECRET=
